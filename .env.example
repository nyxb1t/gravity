# ── AI (Person 1) ──────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ── Slack Experience (Person 2) ────────────────────────────────────────────
# SLACK_BOT_TOKEN      xoxb-… Bot User OAuth Token (required)
SLACK_BOT_TOKEN=

# SLACK_SIGNING_SECRET Found in your Slack app's "Basic Information" page (required)
SLACK_SIGNING_SECRET=

# SLACK_APP_TOKEN      xapp-… App-Level Token for Socket Mode (optional)
#                      Omit or leave empty to run in HTTP mode instead.
SLACK_APP_TOKEN=

# SLACK_PORT           HTTP receiver port (default: 3001, ignored in Socket Mode)
SLACK_PORT=3001